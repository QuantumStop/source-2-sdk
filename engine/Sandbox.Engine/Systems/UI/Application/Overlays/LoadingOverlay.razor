@namespace Sandbox.UI.Overlays
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

<root class="base-default">

	<div class="background" style="background-image: url( @LoadingSplash );"/>				

	<div class="loading-panel">

		<div class="loading-info">

			<Image class="loading-clock" src="ui/static/elements/stopwatch.png"/>

			<div class="status">@Status</div>

			@if ( DownloadPercent is { } percent )
			{
				<div class="download-status">@percent% downloaded</div>
			}

		</div>

	</div>

</root>

@code
{
	public const string LoadingSplash = "ui/static/ignis_splash.png";

	bool ShouldShow => LoadingScreen.IsVisible;
	string Status => FormatStatus( string.IsNullOrWhiteSpace( LoadingScreen.Title )
		? LoadingScreen.Tasks.FirstOrDefault()?.Title
		: LoadingScreen.Title );

	// Weight packages by bytes, including completed downloads, so parallel downloads share one total.
	// This is download progress only: scene loading/compilation can still follow a completed download.
	int? DownloadPercent
	{
		get
		{
			double total = 0;
			double downloaded = 0;
			foreach ( var download in LoadingScreen.Downloads )
			{
				if ( download.TotalSize <= 0 ) continue;
				total += download.TotalSize;
				downloaded += download.TotalSize * download.Fraction;
			}

			if ( total > 0 )
				return (int)Math.Floor( Math.Clamp( downloaded / total, 0, 1 ) * 100 );

			// Party preloads can report a single download without reserving packages first.
			if ( LoadingScreen.Progress is { TotalSize: > 0 } progress && double.IsFinite( progress.Fraction ) )
				return (int)Math.Floor( Math.Clamp( progress.Fraction, 0, 1 ) * 100 );

			return null;
		}
	}

	string FormatStatus( string text )
	{
		if ( string.IsNullOrWhiteSpace( text ) )
			return "";

		// Engine tasks come through as "Loading <something>". We only want the <something>.
		string trimmed = text.TrimStart();
		const string prefix = "Loading";

		if ( trimmed.StartsWith( prefix, StringComparison.OrdinalIgnoreCase ) )
		{
			string remainder = trimmed[prefix.Length..].TrimStart();

			if ( remainder.StartsWith( value: ":" ) || remainder.StartsWith( value: "-" ) || remainder.StartsWith( value: "\u2014" ) )
				remainder = remainder[1..].TrimStart();

			if ( !string.IsNullOrWhiteSpace( remainder ) )
				return remainder;
		}

		return text;
	}

	protected override int BuildHash()
		=> HashCode.Combine( ShouldShow, Status, LoadingScreen.Subtitle, DownloadPercent );
	
	public override void Tick()
	{
		SetClass( "base-default", true );
		SetClass( "visible", ShouldShow );
	}

	protected override string GetRenderTreeChecksum() => nameof( LoadingOverlay );
}
