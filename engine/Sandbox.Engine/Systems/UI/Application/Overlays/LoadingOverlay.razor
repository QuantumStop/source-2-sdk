@namespace Sandbox.UI.Overlays
@using Sandbox;
@using Sandbox.UI;
@inherits Panel

<root class="base-default">

	<div class="background" style="background-image: url( @LoadingSplash );"/>				

	<div class="loading-panel">

		<div class="loading-info">

			<Image class="loading-clock" src="ui/static/elements/stopwatch.png"/>

			@if ( string.IsNullOrWhiteSpace( LoadingScreen.Title ) )
			{
				<div class="status">@FormatStatus( LoadingScreen.Tasks.FirstOrDefault()?.Title )</div>
			}
			else
			{
				<div class="status">@FormatStatus( LoadingScreen.Title )</div>
			}

		</div>

	</div>

</root>

@code
{
	public const string LoadingSplash = "ui/static/ignis_splash.png";

	bool ShouldShow => LoadingScreen.IsVisible;

	string FormatStatus( string text )
	{
		if ( string.IsNullOrWhiteSpace( text ) )
			return "";

		// Engine tasks come through as "Loading <something>". We only want the <something>.
		string trimmed = text.TrimStart();
		const string prefix = "Loading";

		if ( trimmed.StartsWith( prefix, StringComparison.OrdinalIgnoreCase ) )
		{
			string remainder = trimmed[prefix.Length..].TrimStart();

			if ( remainder.StartsWith( value: ":" ) || remainder.StartsWith( value: "-" ) || remainder.StartsWith( value: "\u2014" ) )
				remainder = remainder[1..].TrimStart();

			if ( !string.IsNullOrWhiteSpace( remainder ) )
				return remainder;
		}

		return text;
	}

	protected override int BuildHash()
		=> HashCode.Combine( ShouldShow, LoadingScreen.Title, LoadingScreen.Subtitle, LoadingScreen.Media );
	
	public override void Tick()
	{
		SetClass( "base-default", true );
		SetClass( "visible", ShouldShow );
	}

	protected override string GetRenderTreeChecksum() => nameof( LoadingOverlay );
}
