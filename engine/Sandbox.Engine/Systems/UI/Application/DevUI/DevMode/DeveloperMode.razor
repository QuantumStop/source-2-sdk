@namespace Sandbox.UI.Dev
@inherits Panel

<root id="DeveloperMode"></root>

@code
{
	public static DeveloperMode Current { get; private set; }
	public static DevWindow MainWindow => ConsoleOverlay.MainWindow;
	public static int ConsoleToggleSerial => ConsoleOverlay.ConsoleToggleSerial;
	public static int DevUI
	{
		get => ConsoleOverlay.DevUI;
		set => ConsoleOverlay.DevUI = value;
	}

	public static bool Open
	{
		get => ConsoleOverlay.Open;
		protected set => ConsoleOverlay.Open = value;
	}

	public static bool Focused
	{
		get => ConsoleOverlay.Focused;
		protected set => ConsoleOverlay.Focused = value;
	}

	public static bool WantsInput => ConsoleOverlay.WantsInput;

	public static void CloseIfOwnsInput()
	{
		ConsoleOverlay.CloseIfOwnsInput();
	}

	/// <summary>
	/// When true, active scene changes won't automatically close the developer console.
	/// </summary>
	public static bool KeepConsoleOpenOnSceneChange
	{
		get => ConsoleOverlay.KeepConsoleOpenOnSceneChange;
		set => ConsoleOverlay.KeepConsoleOpenOnSceneChange = value;
	}

	internal static void ResetStartupState()
	{
		ConsoleOverlay.ResetStartupState();
	}

	internal static void CloseForSceneChange()
	{
		ConsoleOverlay.CloseForSceneChange();
	}

	public override void Tick()
	{
		base.Tick();

		Current = this;
		SetClass( "open", Open );
		SetClass( "focused", Focused );
	}

	public override void OnDeleted()
	{
		base.OnDeleted();

		if ( Current == this )
			Current = null;
	}

	public override Panel FindPopupPanel() => ConsoleOverlay.Current is Panel popup ? popup : this;
}
