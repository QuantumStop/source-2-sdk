@namespace Sandbox.UI.Dev
@using Sandbox.UI.Construct
@inherits Panel

<root class="@classes">
    <div @ref="Output" class="message" AllowChildSelection="true" AcceptsFocus="true" @onkeypress="KeyPress">
		<div class="header">
			<div class="text">@message</div>
			<div class="controls">
				@if ( hasStack )
				{
					<div class="stacktoggle" onclick="@ToggleStackTrace" title="Toggle stack trace">
						<i>@(StackTracesVisible ? "unfold_less" : "unfold_more")</i>
					</div>
					@if ( StackTracesVisible )
					{
						<div class="stackcopy" onclick="@CopyStackTrace" title="Copy stack trace">
							<i>content_copy</i>
						</div>
					}
				}
				<div class="close" onclick="@Hide" title="Close"><i>close</i></div>
			</div>
		</div>
        <div @ref="StackHost" class="stack">
			<StackTraceVirtualList @ref="StackScroll" Items="@stackItems" ContentWidthHint="@stackContentWidth" />
		</div>
    </div>
</root>

@code
{
    LogEvent entry;
    bool visible;
	bool hasStack;

	string levelClass;

	static bool StackTracesVisible { get; set; } = true;

    string classes => $"logeventpanel {(visible?"visible":"hidden")} {levelClass} {(visible && hasStack ? "hasstack" : string.Empty)} {(visible && hasStack && StackTracesVisible ? "stackenabled" : string.Empty)}".Trim();

	string DisplayLogger
	{
		get
		{
			var logger = entry.Logger;
			if ( string.IsNullOrWhiteSpace( logger ) )
				return string.Empty;

			if ( logger == "Generic" || logger == "in" )
				return string.Empty;

			return logger;
		}
	}

	string message
	{
		get
		{
			var m = entry.Message ?? string.Empty;
			var logger = DisplayLogger;
			if ( string.IsNullOrEmpty( logger ) || string.IsNullOrEmpty( m ) )
				return m;

			// Avoid double-tagging when the message already includes its own logger prefix.
			var prefix = $"[{logger}]";
			if ( m.StartsWith( prefix, StringComparison.Ordinal ) )
				return m;

			return $"{prefix} {m}";
		}
	}
    Panel Output = default;
    Panel StackHost = default;
    StackTraceVirtualList StackScroll = default;
	string stackText = string.Empty;
	string[] stackLines = [];
	object[] stackItems = [];
	float stackContentWidth;
	bool resetStackScroll;

    public void Switch( LogEvent e )
    {
        entry = e;
		levelClass = ClassForLevel( e.Level );
		stackText = entry.Stack ?? string.Empty;
		stackLines = SplitStackLines( stackText );
		stackItems = CreateStackItems( stackLines );
		stackContentWidth = EstimateStackWidth( stackLines );
		hasStack = !string.IsNullOrWhiteSpace( stackText );
        visible = true;
        StateHasChanged();
        UnselectAllInChildren();
		resetStackScroll = true;

        UpdateStackHeight( stackText );
    }

    void Hide()
    {
        visible = false;
		UpdateStackHeight( string.Empty );
        StateHasChanged();
    }

	void ToggleStackTrace()
	{
		StackTracesVisible = !StackTracesVisible;
		UpdateStackHeight( stackText );
		StateHasChanged();
	}

	void CopyStackTrace()
	{
		Clipboard.SetText( stackText );
		UnselectStackTrace();
	}

    protected override void OnAfterTreeRender( bool firstTime )
    {
        base.OnAfterTreeRender( firstTime );

		UpdateStackHeight( stackText );
		UnselectStackTrace();

        // Reset scroll position when switching entries.
        if ( resetStackScroll && StackScroll.IsValid() )
		{
            StackScroll.ScrollOffset = Vector2.Zero;
			resetStackScroll = false;
		}
    }

	void UnselectStackTrace()
	{
		if ( StackHost.IsValid() )
			StackHost.UnselectAllInChildren();
	}

    void UpdateStackHeight( string stack )
    {
        if ( !StackHost.IsValid() )
            return;

		if ( !visible )
		{
			StackHost.Style.Height = 0;
			StackHost.Style.Dirty();
			return;
		}

		if ( !StackTracesVisible )
		{
			StackHost.Style.Height = 0;
			StackHost.Style.Dirty();
			return;
		}

        if ( string.IsNullOrWhiteSpace( stack ) )
        {
            StackHost.Style.Height = 0;
            StackHost.Style.Dirty();
			return;
		}

		// Approximate a sensible height based on line count (clamped).
		var lineCount = 1;
		for ( var i = 0; i < stack.Length; i++ )
		{
			if ( stack[i] == '\n' )
				lineCount++;
		}

		const float lineHeight = 12f; // font-size is 11px; 12px is a reasonable line height
		var desired = 10f + (lineCount * lineHeight);
		desired = desired.Clamp( 48f, 200f );

		StackHost.Style.Height = desired;
		StackHost.Style.Dirty();
	}

	static string ClassForLevel( LogLevel level )
	{
		return level switch
		{
			LogLevel.Error => "err",
			LogLevel.Warn => "wrn",
			LogLevel.Info => "msg",
			LogLevel.Trace => "msg",
			_ => "msg"
		};
	}

    public override void OnButtonEvent(ButtonEvent e)
    {
        if ( e.HasCtrl && e.Button == "a" && e.Pressed )
        {
            Output.SelectAllInChildren();
			UnselectStackTrace();
        }
    }

	protected override void OnDragSelect( SelectionEvent e )
	{
		base.OnDragSelect( e );
		UnselectStackTrace();
	}

	static string[] SplitStackLines( string stack )
	{
		if ( string.IsNullOrEmpty( stack ) )
			return [];

		return stack.Replace( "\r\n", "\n" ).Replace( '\r', '\n' ).Split( '\n' );
	}

	static object[] CreateStackItems( string[] lines )
	{
		if ( lines is null || lines.Length == 0 )
			return [];

		var items = new object[lines.Length];
		for ( var i = 0; i < lines.Length; i++ )
			items[i] = lines[i];

		return items;
	}

	static float EstimateStackWidth( string[] lines )
	{
		if ( lines is null || lines.Length == 0 )
			return 0;

		var maxChars = 0;
		foreach ( var line in lines )
			maxChars = Math.Max( maxChars, line?.Length ?? 0 );

		return (maxChars * 6f) + 24f;
	}
}
