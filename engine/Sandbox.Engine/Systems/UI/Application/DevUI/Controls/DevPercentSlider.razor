@namespace Sandbox.UI.Dev
@inherits Panel
@using System

<root class="devpercent-slider-row">
	<div class="devpercent-heading">
		<Label @ref="ValueLabel" class="value-label" />
		<name>@Title</name>
	</div>

	<div class="devpercent-slider" @ref="SliderTrack">
		<div class="devpercent-slider-fill" @ref="SliderFill" style="@FillStyle"></div>
		<div class="devpercent-slider-thumb" @ref="SliderThumb" style="@ThumbStyle"></div>
	</div>
</root>

@code
{
	[Parameter] public string Title { get; set; }
	[Parameter] public int Value { get; set; }
	[Parameter] public Action<int> ValueChanged { get; set; }
	[Parameter] public Action<int> Committed { get; set; }

	private Label ValueLabel { get; set; }
	private Panel SliderTrack { get; set; }
	private Panel SliderFill { get; set; }
	private Panel SliderThumb { get; set; }
	private const float TrackInset = 8f;
	private bool IsDragging { get; set; }
	private float GrabOffset { get; set; }
	private int DisplayValue { get; set; }

	private string FillStyle => $"width: {DisplayValue.Clamp( min: 0, max: 100 ) * 0.01f * GetUsableTrackWidth()}px";
	private string ThumbStyle => $"left: {TrackInset + (DisplayValue.Clamp( min: 0, max: 100 ) * 0.01f * GetUsableTrackWidth())}px";

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );
		SetValue( Value );
	}

	public void SetValue( int value )
	{
		if ( IsDragging )
			return;

		value = value.Clamp( min: 0, max: 100 );

		if ( DisplayValue == value )
			return;

		DisplayValue = value;
		ApplyValue();
	}

	protected override void OnMouseDown( MousePanelEvent e )
	{
		base.OnMouseDown( e );

		if ( e.Target != SliderThumb && e.Target != SliderTrack && e.Target != SliderFill )
			return;

		IsDragging = true;
		GrabOffset = e.Target == SliderThumb ? e.LocalPosition.x : SliderThumb.Box.Rect.Width * 0.5f;
		SetMouseCapture( true );
		UpdateSlider();
		e.StopPropagation();
	}

	protected override void OnMouseMove( MousePanelEvent e )
	{
		base.OnMouseMove( e );

		if ( !IsDragging )
			return;

		UpdateSlider();
		e.StopPropagation();
	}

	protected override void OnMouseUp( MousePanelEvent e )
	{
		base.OnMouseUp( e );

		if ( !IsDragging )
			return;

		IsDragging = false;
		SetMouseCapture( false );
		Committed?.Invoke( DisplayValue );
		e.StopPropagation();
	}

	private void UpdateSlider()
	{
		if ( SliderTrack is null || SliderThumb is null || !SliderTrack.IsValid || !SliderThumb.IsValid )
			return;

		Vector2 localMouse = SliderTrack.ScreenPositionToPanelPosition( Mouse.Position );
		float thumbCenterOffset = (SliderThumb.Box.Rect.Width * 0.5f) - GrabOffset;
		float value = ((localMouse.x + thumbCenterOffset - TrackInset) / GetUsableTrackWidth() * 100f).Clamp( 0f, 100f );

		DisplayValue = (int)MathF.Round( value );
		ApplyValue();
		ValueChanged?.Invoke( DisplayValue );
	}

	private void ApplyValue()
	{
		float width = DisplayValue.Clamp( min: 0, max: 100 ) * 0.01f * GetUsableTrackWidth();

		if ( ValueLabel is not null && ValueLabel.IsValid )
			ValueLabel.Text = DisplayValue.ToString();

		if ( SliderFill is not null && SliderFill.IsValid )
		{
			SliderFill.Style.Width = Length.Pixels( width );
			SliderFill.Style.Dirty();
		}

		if ( SliderThumb is not null && SliderThumb.IsValid )
		{
			SliderThumb.Style.Left = Length.Pixels( TrackInset + width );
			SliderThumb.Style.Dirty();
		}
	}

	private float GetUsableTrackWidth()
	{
		if ( SliderTrack is null || !SliderTrack.IsValid )
			return 1f;

		return MathF.Max( 1f, SliderTrack.Box.Rect.Width - (TrackInset * 2f) );
	}
}
