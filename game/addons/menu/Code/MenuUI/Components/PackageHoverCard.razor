@using System;
@using System.Collections.Generic;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@namespace MenuProject.UI
@inherits Panel

<root class="package-hover-card" @onrightclick=@OpenMenu>
    <div class="media" style="background-image: url(@(continuedVideo ? VideoUrl() : Package.ThumbWide ?? Package.Thumb ?? "/ui/sbox-logo-square.svg"))" onclick=@OpenDetails>
        @if ( showVideo && !continuedVideo && !string.IsNullOrEmpty( Package.VideoThumb ) )
        {
            <div class="package-video" style="background-image: url(@VideoUrl())" />
        }

        @if ( !Package.Flair.IsEmpty )
        {
            <MenuProject.UI.PackageFlairBar Flair="@Package.Flair" />
        }

        @if ( Package.Usage.UsersNow > 0 )
        {
            <div class="facts">
                <div class="fact live">
                    <div class="live-dot" />
                    <label>@Compact( Package.Usage.UsersNow ) playing</label>
                </div>
            </div>
        }
    </div>

    <div class="body">
        <div class="title-row">
            <label class="title" onclick=@OpenDetails>@Package.Title</label>

            <div class="fact @ReviewClass()" tooltip="@ReviewText()">
                <icon>@ReviewIcon()</icon>
                <label>@ReviewPercentText()</label>
            </div>

            <div class="fact" tooltip="Players all time">
                <icon>group</icon>
                <label>@Compact( Package.Usage.Total.Users )</label>
            </div>
        </div>

        <div class="byline">
            <label>@Byline()</label>
            @if ( Package.TypeName == "game" && Package.Info.MaxPlayers > 1 )
            {
                <label class="sep">·</label>
                <div class="fact">
                    <icon>groups</icon>
                    <label>@PlayersText()</label>
                </div>
            }
        </div>

        @if ( !string.IsNullOrWhiteSpace( Package.Summary ) )
        {
            <div class="summary">
                <label>@Package.Summary</label>
            </div>
        }

        <div class="footer">
            <div class="tags">
                @foreach ( var tag in Tags() )
                {
                    <label class="tag">@tag</label>
                }
            </div>

            <div class="actions">
                @if ( Package.TypeName == "game" && MenuHelpers.HasAuthority )
                {
                    <div class="button primary" onclick=@Play>
                        <icon>play_arrow</icon>
                        <label>Play</label>
                    </div>
                }
                <div class="button" onclick=@OpenDetails tooltip="Details">
                    <icon>info</icon>
                </div>
            </div>
        </div>
    </div>
</root>

@code {
    const float Scale = 1.35f;
    const float VideoDelay = 0.2f;
    const float HoverGrace = 0.35f;
    const float ScreenPadding = 12f;

    public static PackageHoverCard Current { get; private set; }

    public Panel Source { get; private set; }
    public Package Package { get; private set; }

    float openedAt;
    bool showVideo;
    bool continuedVideo;
    string videoUrl;
    Rect placed;

    static bool IsShowing( Panel source ) => Current.IsValid() && Current.Source == source;

    // Same video url as the card = same player, so the preview continues the card's video.
    public static PackageHoverCard Show( Panel source, Package package, string playingVideoUrl = null )
    {
        if ( IsShowing( source ) )
            return Current;

        Current?.Delete( true );

        var card = new PackageHoverCard
        {
            Source = source,
            Package = package,
            openedAt = RealTime.Now,
            videoUrl = playingVideoUrl,
            showVideo = playingVideoUrl is not null,
            continuedVideo = playingVideoUrl is not null,
        };

        card.Parent = source.FindPopupPanel();
        card.Reposition();

        Current = card;
        return card;
    }

    public void Close()
    {
        if ( Current == this )
            Current = null;

        Delete();
    }

    public override void OnDeleted()
    {
        base.OnDeleted();

        if ( Current == this )
            Current = null;
    }

    public override void Tick()
    {
        base.Tick();

        if ( IsDeleting )
            return;

        if ( !Source.IsValid() || !Source.IsVisible || Source.Box.Rect.Width <= 0 )
        {
            Close();
            return;
        }

        var age = RealTime.Now - openedAt;

        if ( age > HoverGrace && !HasHovered && !Source.HasHovered )
        {
            Close();
            return;
        }

        if ( !showVideo && age >= VideoDelay )
        {
            showVideo = true;
            StateHasChanged();
        }

        Reposition();
    }

    // Scale x the card, centred on its art; the intro scales up from there.
    void Reposition()
    {
        var scale = ScaleFromScreen;
        var src = Source.Box.Rect;
        var art = Source.Children.FirstOrDefault( x => x.HasClass( "image" ) )?.Box.Rect ?? src;

        var width = src.Width * Scale;
        var mediaHeight = width * 9f / 16f;
        var rect = new Rect( src.Center.x - width * 0.5f, art.Center.y - mediaHeight * 0.5f, width, mediaHeight );

        if ( rect.Equals( placed ) )
            return;

        placed = rect;

        Style.Width = rect.Width * scale;
        Style.Left = rect.Left * scale;
        Style.Top = rect.Top * scale;
        Style.TransformOriginY = rect.Height * 0.5f * scale;
        Style.Dirty();
    }

    // Floats in the root, so hand the wheel to the card and let the feed scroll.
    public override void OnMouseWheel( Vector2 value )
    {
        if ( Source.IsValid() )
            Source.OnMouseWheel( value );
        else
            base.OnMouseWheel( value );
    }

    public override void OnLayout( ref Rect layoutRect )
    {
        var size = new Vector2( Screen.Width, Screen.Height );
        if ( size.x <= 0 || size.y <= 0 ) return;

        var pad = ScreenPadding * ScaleToScreen;

        if ( layoutRect.Right > size.x - pad ) layoutRect.Position -= new Vector2( layoutRect.Right - (size.x - pad), 0 );
        if ( layoutRect.Bottom > size.y - pad ) layoutRect.Position -= new Vector2( 0, layoutRect.Bottom - (size.y - pad) );
        if ( pad > layoutRect.Left ) layoutRect.Position += new Vector2( pad - layoutRect.Left, 0 );
        if ( pad > layoutRect.Top ) layoutRect.Position += new Vector2( 0, pad - layoutRect.Top );
    }

    string VideoUrl() => videoUrl ??= PackageCard.VideoUrl( Package, PackageCard.PickQuality( Box.Rect.Width ) );

    void OpenDetails()
    {
        Package.OpenModal();
        Close();
    }

    void Play()
    {
        MenuHelpers.PlayGame( Package );
        Close();
    }

    void OpenMenu() => MenuHelpers.OpenPackageMenu( this, Package );

    string Byline()
    {
        var org = Package.Org?.Title;
        var updated = Package.Updated.LocalDateTime.ToRelativeTimeString();

        return string.IsNullOrEmpty( org ) ? $"Updated {updated}" : $"by {org}  ·  Updated {updated}";
    }

    string PlayersText()
    {
        var max = Package.Info.MaxPlayers;
        var min = Package.Info.MinPlayers;
        return min > 1 && max > min ? $"{min} - {max}" : $"Up to {max}";
    }

    // Review stats when there are any, else the up/down votes. -1 = unrated.
    (int Percent, int Count) Rating()
    {
        var reviews = Package.Reviews;
        if ( reviews.Total > 0 )
            return ((int)Math.Round( reviews.PositiveRatings * 100.0 / reviews.Total ), reviews.Total);

        var votes = Package.VotesUp + Package.VotesDown;
        return (votes > 0 ? (int)(Package.VotesUp * 100f / votes) : -1, votes);
    }

    string ReviewText()
    {
        var (pct, count) = Rating();
        if ( pct == -1 ) return "No reviews yet";

        var verdict = pct switch
        {
            >= 80 => "Very Positive",
            >= 60 => "Positive",
            >= 40 => "Mixed",
            _ => "Negative"
        };

        return $"{verdict} ({Compact( count )})";
    }

    string ReviewPercentText()
    {
        var pct = Rating().Percent;
        return pct == -1 ? "Unrated" : $"{pct}%";
    }

    string ReviewClass() => Rating().Percent switch
    {
        -1 => "unrated",
        >= 60 => "positive",
        >= 40 => "mixed",
        _ => "negative"
    };

    string ReviewIcon() => Rating().Percent switch
    {
        -1 => "star_outline",
        >= 60 => "thumb_up",
        >= 40 => "thumbs_up_down",
        _ => "thumb_down"
    };

    // Only genre-like tags are shown; the backend's genre facet isn't on Package yet.
    static readonly Dictionary<string, string> GenreLabels = new( StringComparer.OrdinalIgnoreCase )
    {
        ["shooter"] = "Shooter", ["fps"] = "FPS", ["tps"] = "Third Person Shooter",
        ["puzzle"] = "Puzzle", ["strategy"] = "Strategy", ["sports"] = "Sports",
        ["roguelike"] = "Roguelike", ["roguelite"] = "Roguelite", ["horror"] = "Horror",
        ["racing"] = "Racing", ["survival"] = "Survival", ["sandbox"] = "Sandbox",
        ["rpg"] = "RPG", ["platformer"] = "Platformer", ["adventure"] = "Adventure",
        ["simulation"] = "Simulation", ["sim"] = "Simulation", ["action"] = "Action",
        ["arcade"] = "Arcade", ["party"] = "Party", ["fighting"] = "Fighting",
        ["rhythm"] = "Rhythm", ["stealth"] = "Stealth", ["towerdefense"] = "Tower Defense",
        ["socialdeduction"] = "Social Deduction", ["deduction"] = "Social Deduction",
        ["deathmatch"] = "Deathmatch", ["battleroyale"] = "Battle Royale", ["parkour"] = "Parkour",
        ["tycoon"] = "Tycoon", ["building"] = "Building", ["roleplay"] = "Roleplay", ["rp"] = "Roleplay",
        ["minigames"] = "Minigames", ["coop"] = "Co-op", ["pvp"] = "PvP", ["casual"] = "Casual",
        ["golf"] = "Golf", ["driving"] = "Driving", ["physics"] = "Physics", ["zombies"] = "Zombies",
    };

    IEnumerable<string> Tags()
    {
        var tags = Package.Tags ?? Array.Empty<string>();
        var genres = tags.Select( x => GenreLabels.GetValueOrDefault( x ) ).Where( x => x is not null ).Distinct();
        var mode = PlayerMode();

        return mode is null ? genres.Take( 2 ) : genres.Take( 1 ).Prepend( mode );
    }

    // Listings carry tags but not the MaxPlayers meta, so check both.
    string PlayerMode()
    {
        var tags = Package.Tags ?? Array.Empty<string>();
        var max = Package.GetMeta( "MaxPlayers", 0 );

        if ( tags.Contains( "multiplayer" ) || tags.Contains( "coop" ) || tags.Contains( "pvp" ) || max > 1 ) return "Multiplayer";
        if ( tags.Contains( "singleplayer" ) || max == 1 ) return "Singleplayer";

        return null;
    }

    static string Compact( long n )
    {
        if ( n >= 1_000_000 ) return $"{n / 1_000_000f:0.#}M";
        if ( n >= 1_000 ) return $"{n / 1_000f:0.#}K";

        return n.ToString();
    }

    protected override int BuildHash() => HashCode.Combine( Package?.FullIdent, Package?.Usage.UsersNow, showVideo, VideoUrl(), MenuHelpers.HasAuthority );
}
