# Ignore all files by default
*
!*/

# Git
!.gitignore
!.gitattributes
!.github/workflows/**

# Source files
!*.sln
!*.csproj
!*.cs
!*.razor


# Sandbox source files
!*.scene
!*.prefab
!*.clothing
!*.sound
!*.decal
!*.sndscape
!*.surface
!*.vtex

# Shader files
!*.shader
!*.fxc
!*.hlsl
!*.hlsli

# Text files
!*.txt
!*.md
!*.ini
!*.cfg
!*.json
!*.css
!.editorconfig
!.yaml
!.yml

# Script files
!*.bat
!*.sh
!*.py

#
# Some junk
#

# Local input files
*#local.json

game/config/input/common.json
*.codegen
engine/CodeGen.deps.json
engine/CodeGen.runtimeconfig.json
.generated
game/core/shadercache/vulkan/shaders.cache
engine/Sandbox.Compiling/EmbeddedRefs/*.xml
game/*.xml
engine/TestResults/

/engine/**/Interop.*.cs

#
# Visual Studio
#
.vs/
.intermediate/

# addon debris
/game/**/.sbox/*
/game/**/*.sln
/game/**/*.csproj
/game/**/obj
/game/**/launchSettings.json

#
# Game debris
#
/game/.source2
/game/_toolsettings
/game/bin/**/*.pdb
/game/bin/**/*.dll
/game/bin/**/*.xml
/game/bin/**/*.json
/game/bin/win64/logs
/game/config/**/*.json
/game/config/**/*.json.backup
/game/core/cfg/*.vcfg
/game/core/cfg/video.txt
/game/core/cfg/video_tools.txt
/game/data
/game/download
/game/download_test
/game/logs
/game/screenshots
/game/tools
/game/aftermath_dumps
/game/gamecache
game/benchmark.runtimeconfig.json
game/sbox.runtimeconfig.json
game/sbox-dev.runtimeconfig.json
game/sbox-launcher.runtimeconfig.json
game/sbox-server.runtimeconfig.json
game/sbox-standalone.runtimeconfig.json

# Don't ignore our new assets or any other tool relatd image
!game/core/tools/images/**
!game/core/**/*.cs.scss
!game/core/**/*.razor.scss
!game/core/styles/**/*.scss
!game/core/Styles/**/*.scss
!game/addons/editor/assets/styles/**/*.scss

!game/bin/thirdparty/*
!game/core/materials/default/default_mask.tga
!game/core/materials/default/default_ao.tga
!game/addons/base/assets/materials/default/default_color.tga
!game/core/materials/default/default_black_mask.tga
!game/core/sounds/editor/*
game/core/sounds/editor/*.vsnd_c
game/addons/menu/Transients
game/core/maps/editor/_bakeresourcecache

# Don't ignore base addon stuff
!game/addons/base/**/*.cs.scss
!game/addons/base/**/*.razor.scss
!game/addons/base/Assets/ui/static/**

# Don't ignore our DevUI addon stuff
!game/addons/devui/.sbproj
!game/addons/devui/**/*.cs.scss
!game/addons/devui/**/*.razor.scss

# Need this for an example in Sweeper, we'll get rid of it in the future
!game/samples/sweeper/Assets/c17imgseq/*
!game/samples/sweeper/Assets/**
!game/samples/sweeper/code/UI/**
